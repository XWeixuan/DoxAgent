{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document3 workflow v2.1 contracts",
  "description": "Published data contract document3.v3 and minimal workflow handoff shapes. Validate records locally; structural failures never become global workflow gates.",
  "$comment": "Initialization uses Shell Discovery then OPEN_RESEARCH and OPEN_EVENT Discovery, followed by GLOBAL Planning and Integration. OPEN is a legacy alias for OPEN_RESEARCH; no third OPEN thread. Build uses all research owners with normal concurrency.",
  "$ref": "#/$defs/PolicySet",
  "$defs": {
    "RefList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "Lead": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "$ref": "#/$defs/RefList"
        }
      },
      "required": [
        "name",
        "lead"
      ]
    },
    "Topic": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "description": "Use a task-allowed research owner: Shell slot/name/alias, OPEN_RESEARCH, or OPEN_EVENT. Host normalizes to stable IDs. GLOBAL only coordinates Planning/Integration.",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "$ref": "#/$defs/RefList"
        }
      },
      "required": [
        "name",
        "owner",
        "brief"
      ]
    },
    "NotSelected": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ref",
        "reason"
      ]
    },
    "Agenda": {
      "type": "object",
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Topic"
          }
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "not_selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotSelected"
          },
          "default": []
        }
      },
      "required": [
        "topics",
        "waves"
      ]
    },
    "ResearchResult": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/RefList"
        }
      },
      "required": [
        "topic",
        "policies",
        "notes"
      ]
    },
    "Relation": {
      "type": "object",
      "properties": {
        "policies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "proposal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "policies",
        "proposal"
      ]
    },
    "Review": {
      "type": "object",
      "properties": {
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        },
        "research_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Topic"
          }
        },
        "coverage_notes": {
          "type": "string"
        },
        "edit_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EditRequest"
          },
          "default": []
        }
      },
      "required": [
        "relations",
        "research_requests",
        "coverage_notes"
      ]
    },
    "Replacement": {
      "type": "object",
      "properties": {
        "before": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "before",
        "after",
        "reason"
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "topic",
        "policies",
        "note"
      ]
    },
    "RemainingGap": {
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "reason"
      ],
      "title": "RemainingGap",
      "type": "object"
    },
    "Consolidation": {
      "type": "object",
      "properties": {
        "replacements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Replacement"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Coverage"
          }
        },
        "remaining_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RemainingGap"
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "replacements",
        "coverage",
        "remaining_gaps",
        "summary"
      ]
    },
    "Calibration": {
      "properties": {
        "reference_state": {
          "minLength": 1,
          "title": "Reference State",
          "type": "string"
        },
        "trigger_boundary": {
          "minLength": 1,
          "title": "Trigger Boundary",
          "type": "string"
        }
      },
      "required": [
        "reference_state",
        "trigger_boundary"
      ],
      "title": "Calibration",
      "type": "object"
    },
    "Condition": {
      "type": "object",
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "LONG",
            "SHORT"
          ]
        },
        "trigger_layer": {
          "type": "string",
          "enum": [
            "OUTER",
            "MIDDLE",
            "INNER"
          ]
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "calibration": {
          "$ref": "#/$defs/Calibration"
        }
      },
      "required": [
        "condition_id",
        "decision",
        "trigger_layer",
        "criterion",
        "calibration"
      ]
    },
    "ConditionDraft": {
      "type": "object",
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "LONG",
            "SHORT"
          ]
        },
        "trigger_layer": {
          "type": "string",
          "enum": [
            "OUTER",
            "MIDDLE",
            "INNER"
          ]
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "calibration": {
          "$ref": "#/$defs/Calibration"
        }
      },
      "required": [
        "decision",
        "trigger_layer",
        "criterion",
        "calibration"
      ]
    },
    "Policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "$ref": "#/$defs/RefList"
        },
        "transmission": {
          "type": "string",
          "minLength": 1
        },
        "match_scope": {
          "type": "string",
          "minLength": 1
        },
        "activation_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "minItems": 1
        }
      },
      "required": [
        "policy_id",
        "title",
        "transmission",
        "match_scope",
        "activation_conditions"
      ]
    },
    "PolicyDraft": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "$ref": "#/$defs/RefList"
        },
        "transmission": {
          "type": "string",
          "minLength": 1
        },
        "match_scope": {
          "type": "string",
          "minLength": 1
        },
        "activation_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionDraft"
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "transmission",
        "match_scope",
        "activation_conditions"
      ]
    },
    "PolicySet": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "document3.v3"
        },
        "workflow_version": {
          "const": "document3.v2.1"
        },
        "ticker": {
          "type": "string",
          "minLength": 1
        },
        "policy_set_version": {
          "type": "integer",
          "minimum": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "publication_state": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "document2_ref": {
          "type": [
            "object",
            "null"
          ],
          "description": "Use the existing D2 snapshot-reference contract; null when no snapshot is available."
        },
        "event_library_ref": {
          "type": [
            "object",
            "null"
          ],
          "description": "Use the existing event-library snapshot-reference contract; null when unavailable."
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Policy"
          }
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "workflow_version",
        "ticker",
        "policy_set_version",
        "as_of",
        "publication_state",
        "document2_ref",
        "event_library_ref",
        "policies",
        "published_at"
      ]
    },
    "EditRequest": {
      "type": "object",
      "properties": {
        "policies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "policies",
        "instruction"
      ]
    },
    "RearmRequest": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "reason"
      ],
      "title": "RearmRequest",
      "type": "object"
    },
    "ConditionDraftV3": {
      "properties": {
        "condition_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Id"
        },
        "decision": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "title": "Decision",
          "type": "string"
        },
        "trigger_layer": {
          "enum": [
            "OUTER",
            "MIDDLE",
            "INNER"
          ],
          "title": "Trigger Layer",
          "type": "string"
        },
        "criterion": {
          "minLength": 1,
          "title": "Criterion",
          "type": "string"
        },
        "calibration": {
          "$ref": "#/$defs/Calibration"
        }
      },
      "required": [
        "decision",
        "trigger_layer",
        "criterion",
        "calibration"
      ],
      "title": "ConditionDraftV3",
      "type": "object"
    },
    "EventLibraryRef": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "ticker": {
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "ticker",
        "version",
        "sha256",
        "published_at"
      ],
      "title": "EventLibraryRef",
      "type": "object"
    },
    "PolicyDraftV3": {
      "properties": {
        "policy_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "ref": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Ref",
          "type": "array"
        },
        "transmission": {
          "minLength": 1,
          "title": "Transmission",
          "type": "string"
        },
        "match_scope": {
          "minLength": 1,
          "title": "Match Scope",
          "type": "string"
        },
        "activation_conditions": {
          "items": {
            "$ref": "#/$defs/ConditionDraftV3"
          },
          "minItems": 1,
          "title": "Activation Conditions",
          "type": "array"
        }
      },
      "required": [
        "title",
        "transmission",
        "match_scope",
        "activation_conditions"
      ],
      "title": "PolicyDraftV3",
      "type": "object"
    },
    "MaintenancePatchV3": {
      "properties": {
        "rearm_requests": {
          "items": {
            "$ref": "#/$defs/RearmRequest"
          },
          "title": "Rearm Requests",
          "type": "array"
        },
        "base_policy_set_version": {
          "minimum": 1,
          "title": "Base Policy Set Version",
          "type": "integer"
        },
        "event_library_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventLibraryRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upsert_policies": {
          "items": {
            "$ref": "#/$defs/PolicyDraftV3"
          },
          "title": "Upsert Policies",
          "type": "array"
        },
        "retire_policy_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Retire Policy Ids",
          "type": "array"
        },
        "remaining_gaps": {
          "items": {
            "$ref": "#/$defs/RemainingGap"
          },
          "title": "Remaining Gaps",
          "type": "array"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "base_policy_set_version",
        "upsert_policies",
        "retire_policy_ids"
      ],
      "title": "MaintenancePatchContractV3",
      "type": "object"
    }
  }
}
