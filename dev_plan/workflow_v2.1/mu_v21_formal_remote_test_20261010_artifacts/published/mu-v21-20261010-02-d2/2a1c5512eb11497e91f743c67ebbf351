            "source_files": {
              "artifacts/c4e_formal_scan/c4e_formal_scan-1-cd75c50f17/report.md": "",
              "artifacts/c4e_formal_scan/c4e_formal_scan-1-cd75c50f17/completion.json": "{\n  \"status\": \"completed\",\n  \"summary\": \"截至 2026-10-09，保留并修正全部 24 条预扫描关系，形成 60 条完整五字段快照。新增具名平台和供给关系，并从 Anthropic 的平台/融资选择、竞争者共享制造、标准与软件适配及电力成本安排继续向外发现；不把计划、验证或承诺升级为出货与订单。\",\n  \"report_markdown\": \"\",\n  \"warnings\": [\n    \"供给协议、平台集成、股权投资及云算力采购是不同联系；未披露的客户名单、存储 BOM、份额和数量保持未知，不将 Anthropic 协议套用为全部战略客户协议。\",\n    \"部分官方 IR/PDF 请求返回 403、重定向或超时；ASML 协议及 Idaho 电力监管关系保留已核实原始链接并明确未取得 O 引用。其余引用均使用本轮实际可用观察；失败不代表关系不存在。\",\n    \"Lenovo、Orin、MI350、CXL 与软件演示按原公告年份及状态保留，不自动升级为 2026 年新增订单、全部版本认证或后续平台采用。\",\n    \"扩建投资、政府支持条件、产品标准、采用计划和功能送样均不等于合格产能或实际部署；投资额、发电容量、IT 负载和存储销量不混用。\"\n  ],\n  \"observation_candidates\": [],\n  \"entity_relations\": [\n    {\n      \"关系主体\": \"美光科技（Micron Technology，MU）\",\n      \"关系对象\": \"大型超大规模云客户（类别关系；不推定完整名单）\",\n      \"关系类型\": \"存储器供应与产品协作\",\n      \"关系说明\": \"CMBU 向大型超大规模云客户提供 DDR、LPDDR、GDDR，并负责所有数据中心客户的 HBM。HBM4 36GB 12-high 已量产，48GB 16-high 为送样；本轮另核实 NVIDIA 平台合作及 Anthropic 供给协议，但不能由此填满此类别或分配全部多年合同。【cite:O3】【cite:O104】【cite:O139】\",\n      \"关联业务或产品\": \"CMBU；HBM、DDR5、高容量 DIMM、低功耗服务器 DRAM\"\n    },\n    {\n      \"关系主体\": \"美光科技（Micron Technology，MU）\",\n      \"关系对象\": \"数据中心 OEM、企业及 NeoCloud 客户（类别关系；完整名单未披露）\",\n      \"关系类型\": \"数据中心内存与存储供应\",\n      \"关系说明\": \"CDBU 向数据中心 OEM、企业及 AI 导向的 NeoCloud 客户供应内存，并向所有数据中心客户提供 SSD 与 NAND 组件；不能将终端工作负载自动等同于具名直接客户。【cite:O3】\",\n      \"关联业务或产品\": \"CDBU；DDR5/DDR4 RDIMM、数据中心 SSD、组件 NAND\"\n    },\n    {\n      \"关系主体\": \"美光科技（Micron Technology，MU）\",\n      \"关系对象\": \"智能手机及其他移动设备 OEM（具体名称未确认）\",\n      \"关系类型\": \"移动存储器供应与认证\",\n      \"关系说明\": \"MCBU 面向移动市场销售 LPDDR 和托管 NAND；2026 财年已向领先智能手机 OEM 批量交付 1γ 16Gb LPDDR5X，24Gb LPDDR5X 和 16Gb LPDDR6 则处于送样或认证送样状态。【cite:O3】\",\n      \"关联业务或产品\": \"MCBU；LPDDR5X、LPDDR4X、LPDDR6、托管 NAND\"\n    },\n    {\n      \"关系主体\": \"美光科技（Micron Technology，MU）\",\n      \"关系对象\": \"客户端 PC 客户及组件渠道伙伴（具体名称未确认）\",\n      \"关系类型\": \"客户端产品与组件供应\",\n      \"关系说明\": \"MCBU 提供 DRAM 模