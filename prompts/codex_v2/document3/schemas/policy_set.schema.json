{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doxagent://codex_document3/policy_set.schema.json",
  "title": "D3 Policy Set V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ticker", "policy_set_version", "publication_state", "document2_ref", "event_library_ref", "policies", "published_at"],
  "properties": {
    "schema_version": {"const": "document3.v2"},
    "ticker": {"type": "string", "minLength": 1},
    "policy_set_version": {"type": "integer", "minimum": 1},
    "publication_state": {"enum": ["COMPLETE", "PARTIAL"]},
    "document2_ref": {"$ref": "#/$defs/document2_ref"},
    "event_library_ref": {"anyOf": [{"$ref": "#/$defs/event_library_ref"}, {"type": "null"}]},
    "policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}},
    "published_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "document2_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "artifact_id", "sha256", "published_at", "publication_state"],
      "properties": {
        "run_id": {"type": "string"}, "artifact_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "published_at": {"type": "string", "format": "date-time"},
        "publication_state": {"enum": ["COMPLETE", "PARTIAL"]}
      }
    },
    "event_library_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "ticker", "version", "sha256", "published_at"],
      "properties": {
        "contract_version": {"type": "string"}, "ticker": {"type": "string"},
        "version": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "published_at": {"type": "string", "format": "date-time"}
      }
    },
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["shell_id", "expectation_id", "gap_id"],
      "properties": {"shell_id": {"type": "string", "minLength": 1}, "expectation_id": {"type": "string", "minLength": 1}, "gap_id": {"type": "string", "minLength": 1}}
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "criterion", "calibration"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1}, "criterion": {"type": "string", "minLength": 1},
        "calibration": {
          "type": "object", "additionalProperties": false,
          "required": ["reference_state", "trigger_boundary", "qualifying_evidence"],
          "properties": {
            "reference_state": {"type": "string", "minLength": 1}, "trigger_boundary": {"type": "string", "minLength": 1}, "qualifying_evidence": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "title", "source_refs", "decision", "match_scope", "activation_conditions", "activation_summary"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_ref"}},
        "decision": {"enum": ["LONG", "SHORT"]}, "match_scope": {"type": "string", "minLength": 1},
        "activation_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}},
        "activation_summary": {"type": "string", "minLength": 1}
      }
    }
  }
}
