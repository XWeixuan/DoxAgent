        "matched_condition_ids": []
      },
      "w3_decision": {
        "novelty": {
          "reason": "E16已记录Bloom与Oracle的关系及Oracle New Mexico数据中心的Bloom燃料电池部署；E40只记录Oracle因数据中心建设延误寻求force-majeure保护的泛化报道。当前消息新增了Oracle拟在New Mexico AI数据中心未按计划于2028年投产时推迟部分付款这一具体合同条件，未被Reference View记录，因此核心事实为NEW。",
          "reference_ids": [
            "E16",
            "E40"
          ],
          "result": "NEW"
        },
        "policy": {
          "matched_condition_ids": [],
          "policy_ids": [],
          "reason": "消息未确认Bloom项目取消、缩量、正式验收窗口跨季度后移或后续申报中的backlog/收入变化；其内容是Oracle据报道提出的、以2028年投产落空为条件的付款推迟请求，未达到现行客户下调或项目延误Policy的触发边界。"
        },
        "expert_trade": {
          "direction": "SHORT",
          "evaluated": true,
          "expectation_delta": "Oracle据报道寻求在New Mexico AI数据中心未能按计划于2028年投产时推迟部分付款，降低该Oracle项目按期兑现的确定性，并提高Bloom相关部署验收、付款/现金转换及收入确认后移的概率；这尚未证明项目已经错过、取消或存在已量化的Bloom特定损失。",
          "prior_expectation": "事件前，Bloom已将Oracle作为直接超大规模客户，并披露Oracle New Mexico数据中心正在使用Bloom燃料电池；市场基线是该大型负荷项目沿已知计划推进并逐步转化为Bloom部署、验收、付款和收入，未有Oracle寻求付款延期的已知条件。",
          "reason": "Surprise来自E16/E40均未包含的具体付款推迟与2028投产条件。Materiality较高：New Mexico是已识别的Oracle-Bloom部署，BE的FY2026增长指引和高估值依赖大型负荷项目持续转化。Transmission清晰为Oracle项目启动风险→Bloom燃料电池部署/验收→付款、收入与经营现金流时点，因此方向为SHORT。Bloom特定付款金额和实际错过2028节点尚未确认，但属于强度不确定性，不破坏当前的方向性预期差。",
          "trade": true
        }
      },
