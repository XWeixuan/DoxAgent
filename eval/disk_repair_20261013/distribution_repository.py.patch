+    @staticmethod
+    def _snapshot(db, value: Any) -> str:
+        payload = canonical_json(value)
+        identity = sha256_text(payload)
+        db.execute("INSERT OR IGNORE INTO distribution_snapshots VALUES(?,?)", (identity, payload))
+        return canonical_json({"$snapshot": identity})
+
+    @staticmethod
+    def _expand(db, payload: str) -> str:
+        value = json.loads(payload)
+        if isinstance(value, dict) and "$snapshot" in value:
+            row = db.execute("SELECT payload FROM distribution_snapshots WHERE snapshot_id=?",
+                             (value["$snapshot"],)).fetchone()
+            if row is None:
+                raise RuntimeError("distribution_snapshot_missing")
+            return row[0]
+        return payload
+
+    def _delivery_identity(self, db, run, article_id, binding, revision, admission, reason, now):
+        # Poll slots are execution identities, not new business work. Sweep ownership
+        # and eligibility transitions (future -> eligible -> expired) remain distinct.
+        scope = run["run_id"] if run["mode"] == "CLOSED_SWEEP" else "REALTIME"
+        key = sha256_text(canonical_json([scope, article_id, binding, revision,
+                                         run["source_json"], admission, reason, "classifier:v1"]))
+        identity = "delivery-" + key[:32]
+        row = db.execute("SELECT delivery_id FROM distribution_delivery_keys WHERE business_key=?",
+                         (key,)).fetchone()
+        if row:
+            db.execute("UPDATE distribution_delivery_keys SET last_seen_at=?,seen_count=seen_count+1 "
+                       "WHERE business_key=?", (now, key))
+            return row[0]
+        db.execute("INSERT INTO distribution_delivery_keys VALUES(?,?,?,?,1)",
+                   (key, identity, now, now))
+        return identity
 
