ARG BASE_IMAGE=doxagent-deps:site
ARG CHROME_RUNTIME_IMAGE=doxagent-chrome:approved-cc38be0a
FROM ${CHROME_RUNTIME_IMAGE} AS approved_chrome
FROM ${BASE_IMAGE} AS supervisor-deps
USER root
ARG GOOGLE_CHROME_VERSION=153.0.8010.52-1
# Import only the approved browser, never its historical application layers.
COPY --from=approved_chrome /opt/google/chrome /opt/google/chrome
RUN ln -sf /opt/google/chrome/google-chrome /usr/bin/google-chrome \
    && ln -sf /opt/google/chrome/google-chrome /usr/bin/google-chrome-stable \
    && test "$(/opt/google/chrome/chrome --version | awk '{print $3}')" = "${GOOGLE_CHROME_VERSION%-*}"
ENV CHROME_BINARY=/usr/bin/google-chrome-stable
FROM supervisor-deps AS source-files
COPY src /source/src
RUN rm -rf /source/src/cdecr/catalogs
FROM supervisor-deps AS supervisor
ARG DOXAGENT_BUILD_COMMIT=unversioned
ARG DOXAGENT_SOURCE_SHA256=""
ENV DOXAGENT_BUILD_COMMIT=${DOXAGENT_BUILD_COMMIT}
LABEL org.opencontainers.image.revision=${DOXAGENT_BUILD_COMMIT} \
      doxagent.source.sha256=${DOXAGENT_SOURCE_SHA256} doxagent.owner=doxagent
COPY --from=source-files /source/src /app/src
COPY prompts /app/prompts
COPY dev_plan/workflow_v2/api_contract /app/dev_plan/workflow_v2/api_contract
COPY deploy/chrome-supervisor-entrypoint.sh /usr/local/bin/chrome-supervisor-entrypoint
RUN find /app/src /app/prompts /app/dev_plan -type d ! -perm -005 -exec chmod a+rx {} + \
    && find /app/src /app/prompts /app/dev_plan -type f ! -perm -004 -exec chmod a+r {} + \
    && chmod 0755 /usr/local/bin/chrome-supervisor-entrypoint
ENTRYPOINT ["/usr/local/bin/chrome-supervisor-entrypoint"]
CMD ["python", "-m", "doxagent.site_strategy.chrome_supervisor", "--socket", "/run/doxagent-chrome/supervisor.sock", "--profile-root", "/site-data/profiles"]
