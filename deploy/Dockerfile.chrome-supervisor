ARG BASE_IMAGE=doxagent-v2:production
FROM ${BASE_IMAGE}

USER root
ARG GOOGLE_CHROME_VERSION=153.0.8010.52-1
RUN apt-get update \
    && apt-get install -y --no-install-recommends xvfb x11vnc locales tzdata util-linux curl gpg \
    && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && groupadd --gid 10001 siteaccess \
    && useradd --uid 10001 --gid 10001 --home-dir /home/siteaccess \
         --create-home --shell /usr/sbin/nologin siteaccess \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
       | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg \
    && printf '%s\n' \
       'deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main' \
       > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       "google-chrome-stable=${GOOGLE_CHROME_VERSION}" \
    && test "$(dpkg-query -W -f='${Version}' google-chrome-stable)" = "${GOOGLE_CHROME_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/chrome-supervisor-entrypoint.sh /usr/local/bin/chrome-supervisor-entrypoint
RUN chmod 0755 /usr/local/bin/chrome-supervisor-entrypoint
ENTRYPOINT ["/usr/local/bin/chrome-supervisor-entrypoint"]
CMD ["python", "-m", "doxagent.site_strategy.chrome_supervisor", "--socket", "/run/doxagent-chrome/supervisor.sock", "--profile-root", "/site-data/profiles"]
