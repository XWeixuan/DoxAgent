ARG BASE_IMAGE=doxagent-v2:production
ARG CHROME_RUNTIME_IMAGE=doxagent-chrome:approved-cc38be0a
FROM ${BASE_IMAGE} AS application
FROM ${CHROME_RUNTIME_IMAGE}
USER root
ARG DOXAGENT_BUILD_COMMIT=unversioned
ENV DOXAGENT_BUILD_COMMIT=${DOXAGENT_BUILD_COMMIT}
LABEL org.opencontainers.image.revision=${DOXAGENT_BUILD_COMMIT}
ARG GOOGLE_CHROME_VERSION=153.0.8010.52-1
# Keep the approved pinned browser/OS; replace all application code and dependencies.
RUN rm -rf /app
COPY --from=application /app /app
RUN test "$(dpkg-query -W -f='${Version}' google-chrome-stable)" = "${GOOGLE_CHROME_VERSION}"
COPY deploy/chrome-supervisor-entrypoint.sh /usr/local/bin/chrome-supervisor-entrypoint
RUN chmod 0755 /usr/local/bin/chrome-supervisor-entrypoint
ENTRYPOINT ["/usr/local/bin/chrome-supervisor-entrypoint"]
CMD ["python", "-m", "doxagent.site_strategy.chrome_supervisor", "--socket", "/run/doxagent-chrome/supervisor.sock", "--profile-root", "/site-data/profiles"]
