ARG BASE_IMAGE=doxagent-deps:backend
FROM ${BASE_IMAGE} AS site-deps

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends xvfb x11vnc locales tzdata util-linux \
    && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && groupadd --gid 10001 siteaccess \
    && useradd --uid 10001 --gid 10001 --home-dir /home/siteaccess \
         --create-home --shell /usr/sbin/nologin siteaccess \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 HOME=/home/siteaccess

FROM site-deps AS site
ARG DOXAGENT_BUILD_COMMIT=unversioned
ARG DOXAGENT_SOURCE_SHA256=""
ENV DOXAGENT_BUILD_COMMIT=${DOXAGENT_BUILD_COMMIT}
LABEL org.opencontainers.image.revision=${DOXAGENT_BUILD_COMMIT} \
      doxagent.source.sha256=${DOXAGENT_SOURCE_SHA256} doxagent.owner=doxagent
COPY src /app/src
COPY prompts /app/prompts
COPY dev_plan/workflow_v2/api_contract /app/dev_plan/workflow_v2/api_contract
RUN chmod -R a+rX /app/src /app/prompts /app/dev_plan
COPY deploy/site-access-entrypoint.sh /usr/local/bin/site-access-entrypoint
COPY deploy/site-login-vnc-relay.py /usr/local/bin/site-login-vnc-relay.py
RUN chmod 0755 /usr/local/bin/site-access-entrypoint /usr/local/bin/site-login-vnc-relay.py
RUN setpriv --reuid=10001 --regid=10001 --init-groups \
    python -c "import doxagent.site_strategy.cli"
ENTRYPOINT ["/usr/local/bin/site-access-entrypoint"]
CMD ["python", "-m", "doxagent.site_strategy.cli", "run-server", "--host", "0.0.0.0", "--port", "8011"]
