ARG BASE_IMAGE=doxagent-v2:production
FROM ${BASE_IMAGE}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends xvfb x11vnc \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/site-access-entrypoint.sh /usr/local/bin/site-access-entrypoint
RUN chmod 0755 /usr/local/bin/site-access-entrypoint
ENTRYPOINT ["/usr/local/bin/site-access-entrypoint"]
CMD ["python", "-m", "doxagent.site_strategy.cli", "run-server", "--host", "0.0.0.0", "--port", "8011"]
