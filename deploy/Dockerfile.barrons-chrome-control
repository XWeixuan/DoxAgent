FROM debian:bookworm-slim

ARG GOOGLE_CHROME_VERSION=153.0.8010.52-1

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl gnupg locales procps tzdata util-linux \
       fonts-liberation fonts-noto-cjk x11vnc xvfb \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
       | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg \
    && printf '%s\n' \
       'deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main' \
       > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       "google-chrome-stable=${GOOGLE_CHROME_VERSION}" \
    && google-chrome-stable --version | grep -Eq '^Google Chrome 153\.' \
    && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && groupadd --gid 10001 chromecontrol \
    && useradd --uid 10001 --gid 10001 --home-dir /home/chromecontrol \
       --create-home --shell /usr/sbin/nologin chromecontrol \
    && install -d -o 10001 -g 10001 -m 0700 /chrome-profile /run/chrome-control \
    && rm -rf /var/lib/apt/lists/*

ENV HOME=/home/chromecontrol \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TZ=America/Los_Angeles

COPY deploy/barrons-chrome-control-entrypoint.sh /usr/local/bin/barrons-chrome-control-entrypoint
RUN chmod 0755 /usr/local/bin/barrons-chrome-control-entrypoint

ENTRYPOINT ["/usr/local/bin/barrons-chrome-control-entrypoint"]
