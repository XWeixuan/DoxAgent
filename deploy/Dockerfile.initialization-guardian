ARG DOXAGENT_BASE_IMAGE=doxagent-deps:backend
ARG DOCKER_CLI_IMAGE=docker:27.5-cli
FROM ${DOCKER_CLI_IMAGE} AS docker_cli
FROM ${DOXAGENT_BASE_IMAGE} AS guardian-deps

# The trusted controller creates/builds repair containers through its existing socket.
# Match the CLI baseline already used by the source-maintenance controller.
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins

FROM guardian-deps AS source-files
COPY src /source/src
RUN rm -rf /source/src/cdecr/catalogs
FROM guardian-deps AS guardian
COPY --from=source-files /source/src /app/src
COPY prompts /app/prompts
COPY dev_plan/workflow_v2/api_contract /app/dev_plan/workflow_v2/api_contract
COPY README.md /app/README.md
RUN uv pip install --no-deps --python /app/.venv/bin/python -e /app
