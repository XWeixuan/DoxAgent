ARG DOXAGENT_BASE_IMAGE=doxagent-v2:production
FROM ${DOXAGENT_BASE_IMAGE}

# The trusted controller creates/builds repair containers through its existing socket.
# Match the CLI baseline already used by the source-maintenance controller.
COPY --from=docker:27.5-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:27.5-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
