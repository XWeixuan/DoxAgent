+async fn managed_root_rollouts(
+    store: &LocalThreadStore,
+    thread_id: codex_protocol::ThreadId,
+) -> ThreadStoreResult<Option<ThreadRollouts>> {
+    let proof_path = store.config.codex_home.join(".doxagent-local-exit").join(format!("{thread_id}.json"));
+    let raw = match tokio::fs::read(proof_path).await {
+        Ok(raw) => raw,
+        Err(err) if err.kind() == ErrorKind::NotFound => return Ok(None),
+        Err(err) => return Err(ThreadStoreError::Internal { message: err.to_string() }),
+    };
+    let invalid = || ThreadStoreError::InvalidRequest { message: "invalid consumed isolated-root owner proof".to_string() };
+    let proof: serde_json::Value = serde_json::from_slice(&raw).map_err(|_| invalid())?;
+    if proof["owner"].as_str() != Some("doxagent-consumed-isolated-root-v1")
+        || proof["thread_id"].as_str() != Some(thread_id.to_string().as_str()) {
+        return Err(invalid());
+    }
+    let path = PathBuf::from(proof["path"].as_str().ok_or_else(invalid)?);
+    let scoped = scoped_rollout_path(store.config.codex_home.join(SESSIONS_SUBDIR), &path, "sessions")
+        .or_else(|_| scoped_rollout_path(store.config.codex_home.join(ARCHIVED_SESSIONS_SUBDIR), &path, "archived sessions"));
+    // A missing file is an interrupted exact exit, not permission to discover
+    // every historical rollout again. Its lexical owner boundary still applies.
+    if !path.starts_with(store.config.codex_home.join(SESSIONS_SUBDIR))
+        && !path.starts_with(store.config.codex_home.join(ARCHIVED_SESSIONS_SUBDIR)) {
+        return Err(invalid());
+    }
+    if path.components().any(|part| part == std::path::Component::ParentDir) {
+        return Err(invalid());
+    }
+    if let Ok(meta) = codex_rollout::read_session_meta_line(&path).await {
+        scoped?;
+        if meta.meta.id != thread_id || meta.meta.history_base.is_some()
+            || codex_rollout::rollout_id_from_path(&path) != Some(thread_id) {
+            return Err(invalid());
+        }
+    } else if path.try_exists().unwrap_or(true) {
+        return Err(invalid());
+    }
+    Ok(Some(ThreadRollouts { thread_id, rollout_ids: HashSet::from([thread_id]), paths: vec![path], known_paths: true }))
+}
