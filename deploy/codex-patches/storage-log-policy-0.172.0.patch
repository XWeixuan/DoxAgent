+fn bounded_storage_log(mut value: String) -> String {
+    const MAX_BYTES: usize = 2048;
+    if value.len() > MAX_BYTES {
+        let mut end = MAX_BYTES;
+        while !value.is_char_boundary(end) { end -= 1; }
+        value.truncate(end);
+        value.push_str(" [diagnostic truncated]");
+    }
+    value
 }
 
