+use super::*;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn w3_context_is_consumed_and_bound_to_the_decision_thread() {
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("context.json");
+    let record = serde_json::json!({
+        "enabled": true,
+        "thread_id": "child",
+        "case_id": "case-1",
+        "task_phase": "trade_decision",
+        "started_at_utc": Utc::now() - chrono::Duration::seconds(73),
+    });
+    tokio::fs::write(&path, serde_json::to_vec(&record).unwrap())
+        .await
+        .unwrap();
+    let snapshot = W3TimeSnapshot::read(&path, "child").await;
+    let (offset, started) = snapshot.0.unwrap();
+    assert!((73..75).contains(&(offset + started.elapsed()).as_secs()));
+    assert!(!path.exists());
+
+    for (thread, phase, enabled) in [
+        ("other-child", "trade_decision", true),
+        ("child", "post_decision_operations", true),
+        ("child", "w3_template", true),
+        ("child", "trade_decision", false),
+    ] {
+        let mut value = record.clone();
+        value["thread_id"] = thread.into();
+        value["task_phase"] = phase.into();
+        value["enabled"] = enabled.into();
+        tokio::fs::write(&path, serde_json::to_vec(&value).unwrap())
+            .await
+            .unwrap();
+        assert!(W3TimeSnapshot::read(&path, "child").await.0.is_none());
+    }
+}
+
+#[tokio::test]
+async fn w3_clock_offset_clamps_future_origins_and_bad_records_are_nonfatal() {
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("context.json");
+    let value = serde_json::json!({
+        "enabled": true,
+        "thread_id": "child",
+        "case_id": "case-2",
+        "task_phase": "trade_decision",
+        "started_at_utc": Utc::now() + chrono::Duration::days(1),
+    });
+    tokio::fs::write(&path, serde_json::to_vec(&value).unwrap())
+        .await
+        .unwrap();
+    assert_eq!(
+        W3TimeSnapshot::read(&path, "child").await.0.unwrap().0,
+        Duration::ZERO
+    );
+    tokio::fs::write(&path, b"partial JSON").await.unwrap();
+    assert!(W3TimeSnapshot::read(&path, "child").await.0.is_none());
+    assert!(W3TimeSnapshot::read(&path, "child").await.0.is_none());
+}
