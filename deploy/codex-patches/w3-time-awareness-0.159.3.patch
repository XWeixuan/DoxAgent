+pub(crate) enum W3TimeScope<'a> {
+    Exclude,
+    Turn(&'a str),
+}
+
+impl W3TimeScope<'_> {
+    pub(crate) fn includes(&self, item: &ResponseItem) -> bool {
+        let ResponseItem::Message {
+            internal_chat_message_metadata_passthrough: Some(metadata),
+            ..
+        } = item
+        else {
+            return true;
+        };
+        let Some(kinds) = &metadata.content_item_kinds else {
+            return true;
+        };
+        kinds.iter().all(|kind| {
+            let Some(turn_id) = kind.0.strip_prefix("w3.time_awareness.") else {
+                return true;
+            };
+            matches!(self, Self::Turn(current) if *current == turn_id)
+        })
+    }
+}
+
+pub(crate) struct W3TimeAwarenessReminder {
+    pub(crate) elapsed_seconds: u64,
+    pub(crate) turn_id: String,
+}
+
+impl ContextualUserFragment for W3TimeAwarenessReminder {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind(format!("w3.time_awareness.{}", self.turn_id))
+    }
+
+    fn role(&self) -> &'static str {
+        "developer"
+    }
+
+    fn requires_separate_message(&self) -> bool {
+        true
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<w3_time_awareness>", "</w3_time_awareness>")
+    }
+
+    fn body(&self) -> String {
+        let reminder = match self.elapsed_seconds {
+            0..120 => "",
+            120..180 => {
+                "。任务耗时较长；评估现有研判和必要核查是否已充分，若充分，请尽快提交最终结果。"
+            }
+            180..240 => {
+                "。任务耗时已明显偏长；除非仍有可能实质改变结论的高价值事实或变量待研究，请在后续几轮内尽早提交最终结果。"
+            }
+            240.. => {
+                "。停止新增调查；基于现有研判，完成现行合同要求的必要提交核验后，立即提交最终结果。"
+            }
+        };
+        format!("Elapsed: {}s{reminder}", self.elapsed_seconds)
+    }
+}
 
