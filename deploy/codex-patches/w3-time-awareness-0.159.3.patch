+use std::path::Path;
+use std::time::Duration;
+use std::time::Instant;
+
+#[cfg(test)]
+#[path = "w3_time_awareness_tests.rs"]
+mod w3_time_awareness_tests;
+
+#[derive(Default)]
+struct W3TimeSnapshot(Option<(Duration, Instant)>);
+
+#[derive(serde::Deserialize)]
+struct W3TimeControlRecord {
+    enabled: bool,
+    #[serde(default)]
+    thread_id: String,
+    #[serde(default)]
+    task_phase: String,
+    #[serde(default)]
+    case_id: String,
+    started_at_utc: Option<DateTime<Utc>>,
+}
+
+impl W3TimeSnapshot {
+    async fn read(path: &Path, thread_id: &str) -> Self {
+        let record = async {
+            let bytes = tokio::fs::read(path).await?;
+            // Consume once: a later non-decision turn cannot reuse a stale record.
+            tokio::fs::remove_file(path).await?;
+            Ok::<_, anyhow::Error>(serde_json::from_slice::<W3TimeControlRecord>(&bytes)?)
+        }
+        .await;
+        let record = match record {
+            Ok(record) => record,
+            Err(error) => {
+                tracing::warn!(%error, "W3 time context unavailable; continuing without reminders");
+                return Self::default();
+            }
+        };
+        if !record.enabled
+            || record.thread_id != thread_id
+            || record.task_phase != "trade_decision"
+            || record.case_id.is_empty()
+        {
+            return Self::default();
+        }
+        let Some(origin) = record.started_at_utc else {
+            return Self::default();
+        };
+        let elapsed = Utc::now()
+            .signed_duration_since(origin)
+            .to_std()
+            .unwrap_or_default();
+        Self(Some((elapsed, Instant::now())))
+    }
+}
+
+pub(super) async fn initialize_w3_time_awareness(sess: &Session, turn: &TurnContext) {
+    if turn.extension_data.get::<W3TimeSnapshot>().is_some() {
+        return;
+    }
+    let snapshot = match std::env::var_os("DOXAGENT_W3_TIME_CONTEXT_FILE") {
+        Some(path) => W3TimeSnapshot::read(Path::new(&path), &sess.thread_id.to_string()).await,
+        None => W3TimeSnapshot::default(),
+    };
+    turn.extension_data.insert(snapshot);
+}
+
+pub(super) async fn record_w3_time_awareness(sess: &Session, turn: &TurnContext) -> bool {
+    let Some(snapshot) = turn.extension_data.get::<W3TimeSnapshot>() else {
+        return false;
+    };
+    let Some((offset, started)) = snapshot.0 else {
+        return false;
+    };
+    let item = ContextualUserFragment::into(crate::context::W3TimeAwarenessReminder {
+        elapsed_seconds: (offset + started.elapsed()).as_secs(),
+        turn_id: turn.sub_id.clone(),
+    });
+    sess.record_conversation_items(turn, turn.model_info(), std::slice::from_ref(&item))
+        .await;
+    true
+}
 
