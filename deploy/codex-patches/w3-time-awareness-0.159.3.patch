+#[test]
+fn w3_time_history_is_append_only_within_a_turn_and_excluded_from_other_consumers() {
+    use crate::context::ContextualUserFragment;
+    use crate::context::W3TimeAwarenessReminder;
+    use crate::context::W3TimeScope;
+
+    let business = user_input_text_msg("Evaluate the event.");
+    let old = ContextualUserFragment::into(W3TimeAwarenessReminder {
+        elapsed_seconds: 301,
+        turn_id: "previous".to_string(),
+    });
+    let first = ContextualUserFragment::into(W3TimeAwarenessReminder {
+        elapsed_seconds: 73,
+        turn_id: "current".to_string(),
+    });
+    let next = ContextualUserFragment::into(W3TimeAwarenessReminder {
+        elapsed_seconds: 180,
+        turn_id: "current".to_string(),
+    });
+    let mut history = create_history_with_items(vec![business, old, first]);
+    let request = history
+        .clone()
+        .for_prompt_with_w3_time_scope(&default_input_modalities(), W3TimeScope::Turn("current"));
+    history.record_items(std::iter::once(&next), TruncationPolicy::Tokens(10_000));
+    let continuation = history
+        .clone()
+        .for_prompt_with_w3_time_scope(&default_input_modalities(), W3TimeScope::Turn("current"));
+    assert!(continuation.starts_with(&request));
+    assert_eq!(continuation.len(), request.len() + 1);
+    let expected: Vec<_> = continuation
+        .into_iter()
+        .filter(|item| W3TimeScope::Exclude.includes(item))
+        .collect();
+    assert_eq!(
+        history.clone().for_prompt(&default_input_modalities()),
+        expected
+    );
+    let compaction: Vec<_> = history
+        .for_prompt_annotated(&default_input_modalities())
+        .into_iter()
+        .map(ResponseItemEnvelope::into_item)
+        .collect();
+    assert_eq!(compaction, expected);
+}
