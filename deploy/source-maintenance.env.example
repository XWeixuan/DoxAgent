# Examples only; not loaded from .env.v2 or production Compose.
DOXAGENT_SOURCE_MAINTENANCE_ENABLED=false
DOXAGENT_SOURCE_MAINTENANCE_MODE=shadow
DOXAGENT_SOURCE_MAINTENANCE_ROOT=/var/lib/doxagent/source-maintenance
DOXAGENT_SOURCE_MAINTENANCE_SOURCES=["barrons_ticker_news","investorshub_ticker_news","investing_ticker_news","digitimes_semiconductors","reuters_site_search"]
DOXAGENT_SOURCE_MAINTENANCE_SITES=["barrons","investorshub","investing","digitimes","reuters"]
DOXAGENT_SOURCE_MAINTENANCE_MODEL=gpt-6.1-sol
DOXAGENT_SOURCE_MAINTENANCE_EFFORT=medium
DOXAGENT_SOURCE_MAINTENANCE_COMPOSE_FILES=[]
