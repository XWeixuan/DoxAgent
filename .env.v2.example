# Copy to .env.v2 (0600). No frontend secrets or alternate authentication modes.
# Per-ticker D2/D3 Shell execution limits, shared by v2.0 and v2.1 entrypoints.
DOXAGENT_CODEX_D2_MAX_CONCURRENCY=4
DOXAGENT_CODEX_D3_MAX_CONCURRENCY=4
DOXAGENT_DASHBOARD_SUPABASE_URL=https://PROJECT.supabase.co
DOXAGENT_DASHBOARD_SUPABASE_PUBLISHABLE_KEY=
DOXAGENT_CODEX_WORKER_BEARER_TOKEN=
DOXAGENT_CODEX_CAPABILITY_SECRET=
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DOXAGENT_PERSISTENT_RUNTIME_V2_MODEL=qwen3.8-flash
# Formal data providers required by the selected research/source configuration.
DOXAGENT_DATABASE_URL=
CDECR_SUPABASE_URL=
CDECR_SUPABASE_PUBLISHABLE_KEY=
DEEPSEEK_API_KEY=
# D1/D2/O4 configured sources may also require these production provider keys.
SEC_USER_AGENT=DoxAgent/2.0 operator@example.com
FMP_API_KEY=
TIKHUB_API_KEY=
# Configure actual providers here; keep secrets out of Compose and browser builds.
# Codex authentication: provision /data/codex-home using the official SDK CLI login.
# Profiles are immutable JSON imported through trade_execution.cli, then bound per ticker.
# IBKR endpoints must be reachable from v2-executor, e.g. host.docker.internal.
# Message Bus v2 hidden ingress lists are global and intentionally empty by default.
DOXAGENT_MESSAGE_BUS_V2_HIDDEN_NEWS_DOMAINS=
DOXAGENT_MESSAGE_BUS_V2_HIDDEN_NEWS_PUBLISHERS=
IBKR_NEWS_CLIENT_ID=73
DOXAGENT_CRAWLER_PLANE_BROWSER_HEADLESS=true
DOXAGENT_CRAWLER_PLANE_BROWSER_CHANNEL=
DOXAGENT_CRAWLER_PLANE_BROWSER_IDENTITY_DIR=
# Site Access tokens live in Compose secret files, not in this env file.
DOXAGENT_SITE_ACCESS_ENABLED=false
DOXAGENT_SITE_ACCESS_BROWSER_HEADLESS=true
DOXAGENT_SITE_ACCESS_BROWSER_MAX_PROCESSES=4
DOXAGENT_SITE_ACCESS_BROWSER_MAX_PAGES=4
DOXAGENT_SITE_ACCESS_BROWSER_IDLE_SECONDS=300

# Bounded SQLite query processes. Public retention floors cannot be shortened.
DOXAGENT_V2_DB_QUERY_WORKERS=2
DOXAGENT_V2_DB_QUERY_QUEUE=16
DOXAGENT_V2_DB_QUERY_SECONDS=2
DOXAGENT_V2_DB_DETAIL_SECONDS=5
DOXAGENT_V2_DB_MVCC_HOURS=24
DOXAGENT_V2_DB_DIAGNOSTIC_DAYS=30
# The maintenance Compose profile is opt-in. Do not enable during data-preserving deployment.
