# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:0.8.14-python3.11-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    CODEX_HOME=/var/lib/codex

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin codexworker

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-group dev

COPY prompts/codex_v2 ./prompts/codex_v2
RUN mkdir -p /var/lib/doxagent/workspaces /var/lib/codex \
    && chown -R codexworker:codexworker /var/lib/doxagent /var/lib/codex

USER codexworker
EXPOSE 8791

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8791/healthz', timeout=3).read()"

CMD ["python", "-m", "doxagent.codex_worker"]
