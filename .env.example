# DoxAgent local environment template.
#
# Phase 0 defaults are mock-first. Do not enable real external services unless a
# later phase explicitly wires the corresponding client.

# Model provider credentials. agent_runner defaults to DashScope Bailian.
DASHSCOPE_API_KEY=
DASHSCOPE_FALLBACK_API_KEY=
DASHSCOPE_FALLBACK_API_KEYS=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_ENABLE_THINKING=true
DASHSCOPE_THINKING_BUDGET=2000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith tracing is off by default in Phase 0.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doxagent-local

# DoxAtlas is represented by fixtures/mocks by default.
DOXATLAS_MODE=mock
DOXATLAS_API_BASE_URL=
DOXATLAS_API_KEY=
DOXATLAS_TOOL_BASE_URL=
DOXATLAS_TOOL_SERVER_TOKEN=

# Real tool/provider keys remain opt-in. Leave blank for mock-first local tests.
MARKET_DATA_MODE=mock
FACT_CHECK_MODE=mock
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
DATA_GOV_API_KEY=
CENSUS_API_KEY=
EIA_API_KEY=
EIA_BASE_URL=https://api.eia.gov/v2
SAM_GOV_API_KEY=
CENSUS_M3_BASE_URL=https://api.census.gov
ALPHA_VANTAGE_API_KEY=
TWELVEDATA_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
TAVILY_API_KEY=
ANYSEARCH_API_KEY=
SEC_USER_AGENT=DoxAgent/0.1 contact@example.com
SEC_MIN_REQUEST_INTERVAL_SECONDS=0.12
FRED_MIN_REQUEST_INTERVAL_SECONDS=0.55

# Legacy Message Bus storage remains available for read-only/reference tooling.
DOXAGENT_MONITORING_STORAGE_MODE=sqlite
DOXAGENT_MONITORING_SQLITE_PATH=.tmp/monitoring_message_bus.sqlite3
DOXAGENT_MONITORING_VIEWER_REFRESH_SECONDS=5
DOXAGENT_MONITORING_POLLER_SLEEP_SECONDS=15
DOXAGENT_MONITORING_REMOTE_SSH_ALIAS=doxagent-hk
DOXAGENT_MONITORING_REMOTE_PATH=/root/doxagent
DOXAGENT_MONITORING_REMOTE_TIMEOUT_SECONDS=20
# Formal Message Bus v2 is source-agnostic and disabled until explicitly enabled.
DOXAGENT_MESSAGE_BUS_V2_ENABLED=0
DOXAGENT_MESSAGE_BUS_V2_SQLITE_PATH=.tmp/message_bus_v2.sqlite3
DOXAGENT_MESSAGE_BUS_V2_WORKER_SLEEP_SECONDS=1
DOXAGENT_MESSAGE_BUS_V2_ADAPTER_ROOT=.tmp/message_bus_v2_adapters
DOXAGENT_MESSAGE_BUS_V2_CONTENT_ENRICHMENT_ENABLED=1
DOXAGENT_CONTENT_ENRICHMENT_ENABLED=1
DOXAGENT_CONTENT_ENRICHMENT_MAX_CONCURRENCY=8
DOXAGENT_CONTENT_ENRICHMENT_RETRY_DEADLINE_SECONDS=180
DOXAGENT_CONTENT_ENRICHMENT_RETRY_DELAY_SECONDS=30
DOXAGENT_CONTENT_ENRICHMENT_WORKER_SLEEP_SECONDS=0.25
DOXAGENT_CRAWLER_PLANE_ROOT=.tmp/crawler-plane
DOXAGENT_CRAWLER_PLANE_SQLITE_PATH=.tmp/crawler-plane/crawler_plane.sqlite3
DOXAGENT_CRAWLER_PLANE_WORKER_PROCESSES=4
DOXAGENT_CRAWLER_PLANE_EXECUTION_TIMEOUT_SECONDS=120
DOXAGENT_CRAWLER_PLANE_MAX_RESPONSE_BYTES=10000000
BENZINGA_API_KEY=
BENZINGA_BASE_URL=https://api.benzinga.com
BENZINGA_CACHE_TTL_SECONDS=900
BENZINGA_NEWS_BASE_URL=https://api.benzinga.com
# Official local TWS socket path. Keep disabled until the bottom-layer smoke
# test passes; host is intentionally restricted to localhost in phase one.
IBKR_TWS_ENABLED=false
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=7496
IBKR_TWS_CLIENT_ID=71
IBKR_TWS_TIMEOUT_SECONDS=20
# 1=live, 2=frozen, 3=delayed fallback, 4=delayed frozen. TWS still returns
# live data when the account has the relevant live-data entitlement.
IBKR_TWS_MARKET_DATA_TYPE=3
STOCKTWITS_RAPIDAPI_KEY=
STOCKTWITS_RAPIDAPI_FALLBACK_KEY=
STOCKTWITS_RAPIDAPI_BASE_URL=https://stocktwits-sentiment-message-analytics-api.p.rapidapi.com
STOCKTWITS_RAPIDAPI_HOST=stocktwits-sentiment-message-analytics-api.p.rapidapi.com
STOCKTWITS_PUBLIC_BASE_URL=https://api.stocktwits.com/api/2
STOCKTWITS_PUBLIC_PATH_TEMPLATE=/streams/symbol/{symbol}.json
STOCKTWITS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
STOCKTWITS_ACCEPT_LANGUAGE=en-US,en;q=0.9
DOXAGENT_STOCKTWITS_STORAGE_MODE=sqlite
DOXAGENT_STOCKTWITS_SQLITE_PATH=.tmp/stocktwits_polling.sqlite3
DOXAGENT_STOCKTWITS_ALLOW_POSTGRES=0
DOXAGENT_STOCKTWITS_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN,META,GOOGL,AMD,PLTR,MU
DOXAGENT_STOCKTWITS_TARGET_CADENCE_SECONDS=300
DOXAGENT_STOCKTWITS_HOT_CADENCE_SECONDS=90
DOXAGENT_STOCKTWITS_SCHEDULER_TICK_SECONDS=30
DOXAGENT_STOCKTWITS_PAGE_SIZE=30
DOXAGENT_STOCKTWITS_MAX_PAGES_PER_CRAWL=10
DOXAGENT_STOCKTWITS_HOT_MESSAGE_THRESHOLD=80
DOXAGENT_STOCKTWITS_HOT_COOLDOWN_SUCCESSES=3
DOXAGENT_STOCKTWITS_MIN_REQUEST_INTERVAL_SECONDS=1.0
DOXAGENT_STOCKTWITS_REQUEST_TIMEOUT_SECONDS=15
DOXAGENT_STOCKTWITS_MAX_RETRIES=3
DOXAGENT_STOCKTWITS_RETRY_BASE_DELAY_SECONDS=1.0
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
DOXAGENT_MONITORING_RSS_USER_AGENT=DoxAgent/0.1 monitoring-message-bus

# Unified runtime scheduler state.
DOXAGENT_RUNTIME_SCHEDULER_STORAGE_MODE=sqlite
DOXAGENT_RUNTIME_SCHEDULER_SQLITE_PATH=.tmp/runtime_scheduler.sqlite3
DOXAGENT_RUNTIME_SCHEDULER_LOOP_SLEEP_SECONDS=15

# Persistent Runtime trade-intent store shared by the scheduler, auditor, and Dashboard.
DOXAGENT_PERSISTENT_RUNTIME_STORAGE_MODE=sqlite
DOXAGENT_PERSISTENT_RUNTIME_SQLITE_PATH=.tmp/persistent_runtime_execution.sqlite3

# Isolated DoxAgent V2 Persistent Runtime. Eligibility comes from ticker/source bindings.
DOXAGENT_PERSISTENT_RUNTIME_V2_ENABLED=0
DOXAGENT_PERSISTENT_RUNTIME_V2_STORAGE_MODE=hybrid
DOXAGENT_PERSISTENT_RUNTIME_V2_SQLITE_PATH=.tmp/persistent_runtime_v2.sqlite3
DOXAGENT_PERSISTENT_RUNTIME_V2_REMOTE_PROJECTION_ENABLED=1
DOXAGENT_PERSISTENT_RUNTIME_V2_MODEL=qwen3.8-flash
DOXAGENT_PERSISTENT_RUNTIME_V2_REASONING_EFFORT=medium
DOXAGENT_PERSISTENT_RUNTIME_V2_STRICT_MODE=1
  DOXAGENT_PERSISTENT_RUNTIME_V2_SESSION_CACHE_ENABLED=0
DOXAGENT_PERSISTENT_RUNTIME_V2_TIMEOUT_SECONDS=60
DOXAGENT_PERSISTENT_RUNTIME_V2_RETRY_ATTEMPTS=2
DOXAGENT_PERSISTENT_RUNTIME_V2_FIRST_RETRY_DELAY_SECONDS=5
DOXAGENT_PERSISTENT_RUNTIME_V2_SECOND_RETRY_DELAY_SECONDS=10
DOXAGENT_PERSISTENT_RUNTIME_V2_PROMPT_ROOT=prompts/persistent_runtime_v2
DOXAGENT_PERSISTENT_RUNTIME_V2_W3_ENABLED=1
DOXAGENT_PERSISTENT_RUNTIME_V2_W3_MODEL=gpt-5.6-luna
DOXAGENT_PERSISTENT_RUNTIME_V2_W3_REASONING_EFFORT=max
DOXAGENT_PERSISTENT_RUNTIME_V2_W3_TIMEOUT_SECONDS=600
DOXAGENT_PERSISTENT_RUNTIME_V2_W3_MAX_TICKER_CONCURRENCY=5
DOXAGENT_PERSISTENT_RUNTIME_V2_W3_LEASE_SECONDS=1200
DOXAGENT_PERSISTENT_RUNTIME_V2_W3_PROMPT_ROOT=prompts/persistent_runtime_v2/w3

# Intent-level paper-trading revenue audit. The provider is explicit; there is no
# hidden automatic provider switching. Twelve Data was validated for historical 1m bars.
DOXAGENT_REVENUE_AUDIT_STORAGE_MODE=sqlite
DOXAGENT_REVENUE_AUDIT_SQLITE_PATH=.tmp/revenue_audit.sqlite3
DOXAGENT_REVENUE_AUDIT_MARKET_DATA_PROVIDER=twelvedata
DOXAGENT_REVENUE_AUDIT_METHOD_VERSION=paper-trade-v1
DOXAGENT_REVENUE_AUDIT_SLIPPAGE_BPS=5
DOXAGENT_REVENUE_AUDIT_BASE_NOTIONAL_USD=10000
DOXAGENT_REVENUE_AUDIT_SMALL_MULTIPLIER=0.5
DOXAGENT_REVENUE_AUDIT_NORMAL_MULTIPLIER=1.0
DOXAGENT_REVENUE_AUDIT_AGGRESSIVE_MULTIPLIER=2.0
DOXAGENT_REVENUE_AUDIT_AUTO_TRIGGER_HOUR_ET=18
DOXAGENT_REVENUE_AUDIT_LOOP_SLEEP_SECONDS=60
DOXAGENT_REVENUE_AUDIT_MARKET_DATA_TIMEOUT_SECONDS=30

# Unified model usage cost audit. Use postgres in production so history survives
# container recreation; sqlite remains available for isolated local runs.
DOXAGENT_MODEL_USAGE_STORAGE_MODE=sqlite
DOXAGENT_MODEL_USAGE_SQLITE_PATH=.tmp/model_usage.sqlite3
DOXAGENT_MODEL_PRICING_CONFIG_PATH=
DOXAGENT_MODEL_PRICING_DISCOUNT_RATE=0.45
DOXAGENT_MODEL_PRICING_CNY_USD_RATE=6.8

# Conservative local defaults for free-tier tools.
DOXAGENT_TOOL_HTTP_TIMEOUT_SECONDS=15
FINNHUB_MAX_STREAM_SECONDS=10
FINNHUB_MAX_STREAM_EVENTS=100

# Storage defaults to in-memory. Use a URL-encoded Postgres connection string
# for Supabase direct connections when explicitly enabling persistence.
DOXAGENT_STORAGE_MODE=memory
DOXAGENT_DATABASE_URL=

# Additive Codex SDK Document 1 v2. Keep disabled until the worker has a
# persisted ChatGPT login (`docker compose --profile codex-v2 run --rm
# codex-worker python -m doxagent.codex_worker.login`). Generate both secrets independently.
DOXAGENT_CODEX_D1_V2_ENABLED=false
# New independent Global Research and Market Situation Research lanes.
DOXAGENT_CODEX_RESEARCH_LANES_ENABLED=false
# Persistent per-ticker O4 monitoring configuration/delivery/repair workflow.
# It is independent from the Message Bus v2 flag, but operational tools and
# non-blocking startup require both flags to be true.
DOXAGENT_CODEX_MONITORING_O4_ENABLED=false
DOXAGENT_CODEX_MONITORING_O4_SQLITE_PATH=.tmp/codex-monitoring-o4.sqlite3
DOXAGENT_CODEX_MONITORING_O4_MODEL=gpt-5.6-sol
DOXAGENT_CODEX_MONITORING_O4_TIMEOUT_SECONDS=7200
DOXAGENT_CODEX_MONITORING_O4_WORKER_SLEEP_SECONDS=1
DOXAGENT_CODEX_WORKER_BASE_URL=http://127.0.0.1:8791
DOXAGENT_CODEX_WORKER_BEARER_TOKEN=
DOXAGENT_CODEX_CAPABILITY_SECRET=
DOXAGENT_CODEX_WORKSPACE_ROOT=.tmp/codex-workspaces
# Worker-internal only: Docker Compose sets this after making the container root
# filesystem read-only. Never set it for direct host SDK execution.
DOXAGENT_CODEX_CONTAINER_ISOLATION=false
# Use hybrid after the Supabase runtime migration has been applied. Evidence
# text remains in SQLite; structured runtime state is stored remotely.
DOXAGENT_CODEX_RUNTIME_STORAGE_MODE=sqlite
DOXAGENT_CODEX_RUNTIME_SQLITE_PATH=.tmp/codex-runtime.sqlite3
# Keep false for node tests and normal local runs. PostgreSQL/Supabase runtime
# persistence is blocked unless this egress-sensitive opt-in is explicitly true.
DOXAGENT_CODEX_REMOTE_RUNTIME_STORAGE_ENABLED=false
DOXAGENT_CODEX_HYBRID_LOCAL_MIRROR_ENABLED=true
# Optional private Supabase Storage for published documents larger than 2 MiB.
# The secret key is backend-only and must never be exposed to the frontend/worker.
DOXAGENT_CODEX_PUBLISHED_STORAGE_URL=
DOXAGENT_CODEX_PUBLISHED_STORAGE_SECRET_KEY=
DOXAGENT_CODEX_PUBLISHED_STORAGE_BUCKET=codex-published-documents
DOXAGENT_CODEX_MODEL=gpt-5.6-luna
DOXAGENT_CODEX_MODEL_PROVIDER=
DOXAGENT_CODEX_REASONING_EFFORT=max
DOXAGENT_CODEX_NODE_TIMEOUT_SECONDS=1800
DOXAGENT_CODEX_NODE_MAX_ATTEMPTS=2
DOXAGENT_CODEX_MAX_SUBAGENTS=2

# Frontend branch is separate from backend enablement and defaults off.
VITE_CODEX_D1_V2_ENABLED=false
VITE_CODEX_RESEARCH_LANES_ENABLED=false
# Standalone CDECR module (read-only DoxAtlas input; no service-role key)
CDECR_SUPABASE_URL=
CDECR_SUPABASE_PUBLISHABLE_KEY=
CDECR_SQLITE_PATH=.tmp/cdecr/cdecr.sqlite3
CDECR_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
CDECR_DEEPSEEK_BASE_URL=https://api.deepseek.com
CDECR_M2_PROVIDER=dashscope
CDECR_M3_PROVIDER=dashscope
CDECR_M4_PROVIDER=dashscope
CDECR_MODEL_M1=qwen3.7-text-embedding
CDECR_MODEL_M2=qwen3.8-flash
CDECR_MODEL_M3=qwen3.8-flash
CDECR_MODEL_M4=qwen3.8-flash
CDECR_M2_REASONING_EFFORT=none
CDECR_M3_REASONING_EFFORT=low
CDECR_M4_REASONING_EFFORT=high
CDECR_M2_STRICT=false
CDECR_M3_STRICT=false
CDECR_M4_STRICT=false
CDECR_RELEVANCE_FILTER_MODE=enforce
CDECR_RELEVANCE_TARGET_PROFILES={}
CDECR_ATOMIC_HARD_CANNOT_LINK_MODE=enforce
CDECR_N9_WIRE_PROTOCOL=on
CDECR_FIELD_EPOCH_PLANNED_BATCHING=true
CDECR_GROUNDER_SAFE_NORMALIZATION=true
CDECR_GROUNDER_PRIMARY_NORMALIZATION=shadow
CDECR_N9_OVERLAP_BATCH_PACKING=false
CDECR_PARENT_COMPACT_WIRE_DTO=true
CDECR_EMBEDDING_DIMENSIONS=1024
CDECR_HTTP_TIMEOUT_SECONDS=30
CDECR_MODEL_TIMEOUT_SECONDS=600
# Tier lanes are independent ceilings; they are not a shared total budget.
CDECR_SCHEDULER_M1_CONCURRENCY=64
CDECR_SCHEDULER_M2_CONCURRENCY=128
CDECR_SCHEDULER_M3_CONCURRENCY=160
CDECR_SCHEDULER_M4_CONCURRENCY=96
CDECR_STRUCTURED_REQUEST_START_INTERVAL_SECONDS=0.0
CDECR_STRUCTURED_PROVIDER_TARGET_CONCURRENCY=100
CDECR_STRUCTURED_PROVIDER_HARD_CONCURRENCY=160
CDECR_STRUCTURED_PROVIDER_START_RATE=50
CDECR_STRUCTURED_PROVIDER_INITIAL_BURST=80
CDECR_PROVIDER_MAX_RETRIES=2
CDECR_PROVIDER_KEY_ROTATION_ENABLED=false
CDECR_PROVIDER_AUTO_QUARANTINE_ENABLED=false
CDECR_PROVIDER_FIRST_PAUSE_SECONDS=8
CDECR_PROVIDER_SECOND_PAUSE_SECONDS=20
CDECR_PROVIDER_HALF_OPEN_PROBES=2
CDECR_PROVIDER_RECOVERY_START_RATE=5
CDECR_PROVIDER_RECOVERY_INITIAL_CONCURRENCY=8
CDECR_STRUCTURED_PROVIDER_KEY_QUARANTINE_SECONDS=14400
CDECR_DOCUMENT_WORKERS=120
CDECR_DOCUMENT_BLOCK_CONCURRENCY=24
CDECR_DREAMER_ACTIVE_REQUESTS=100
CDECR_DREAMER_RELEVANCE_ACTIVE_REQUESTS=100
CDECR_GROUNDER_ACTIVE_REQUESTS=100
CDECR_JUDGE_ACTIVE_REQUESTS=64
CDECR_FIELD_ACTIVE_REQUESTS=100
CDECR_N9_ACTIVE_REQUESTS=72
CDECR_N9_ESCALATION_ACTIVE_REQUESTS=32
CDECR_N9_LATE_ACTIVE_REQUESTS=24
CDECR_PARENT_INDUCTION_ACTIVE_REQUESTS=96
CDECR_PARENT_INDUCTION_MAX_DOCUMENTS=4
CDECR_PARENT_INDUCTION_MAX_SLICES=48
CDECR_PARENT_CONTEXT_SOFT_TOKEN_BUDGET=6000
CDECR_PACKAGE_V3_BATCH_SIZE=200
CDECR_PACKAGE_V3_PROVIDER=dashscope
CDECR_PACKAGE_V3_MODEL=qwen3.8-flash
CDECR_PACKAGE_V3_REASONING_EFFORT=low
CDECR_PACKAGE_V3_DESCRIPTION_REASONING_EFFORT=none
CDECR_ATOMIC_COSINE_BACKEND=matrix
CDECR_BULK_REGISTRY_READ_MODE=snapshot
CDECR_PACKAGE_V3_CONTEXT_TOKEN_BUDGET=100000
CDECR_PACKAGE_V3_CONTEXT_RESERVE_TOKENS=8000
CDECR_PACKAGE_V3_DESCRIPTION_TOKEN_BUDGET=32000
CDECR_PACKAGE_V3_DESCRIPTION_ACTIVE_REQUESTS=16
CDECR_PACKAGE_V3_REGISTRY_SCOPE=cdecr-default
CDECR_ITEM_REPAIR_ACTIVE_REQUESTS=16
CDECR_WRITER_QUEUE_LOW_WATERMARK=1000
CDECR_WRITER_QUEUE_HIGH_WATERMARK=5000
CDECR_WRITER_QUEUE_HARD_LIMIT=10000
CDECR_BATCH_AUDIT_WRITE=true
CDECR_STAGE_READ_SNAPSHOT=true
CDECR_CHUNKED_STAGE_APPLY=true
CDECR_BATCH_TASK_LEDGER=true
CDECR_EMBEDDING_BATCH_EXECUTOR=true

# Ticker initialization CDECR execution/adoption policy.
DOXAGENT_CDECR_EXECUTION_MODE=LOCAL_ONLY
DOXAGENT_CDECR_PREBUILT_ROOT=.tmp/cdecr-prebuilt
DOXAGENT_CDECR_PREBUILT_MAX_AGE_HOURS=24
DOXAGENT_CDECR_PREBUILT_COMPATIBILITY_VERSION=cdecr-prebuilt-runtime-v1

# Optional read-only Published Canonical Event Library consumers (W1 / Document2).
DOXAGENT_EVENT_LIBRARY_ROOT=
DOXAGENT_EVENT_LIBRARY_MARKET=US
